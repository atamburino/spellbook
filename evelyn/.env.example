# Copy this file to .env and fill in your own values. .env is gitignored —
# nothing in here should ever be committed.

# Required: your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Model to run the brain on. claude-sonnet-5 is a good default for a
# tool-calling assistant loop.
EVELYN_MODEL=claude-sonnet-5

# Safety switch for the message tool. As long as this is "false" (the
# default), Evelyn will only ever PRINT what she would have sent, never
# actually send it. Flip to "true" only once you've wired send_text() in
# brain/tools/message_tool.py to a real provider (iMessage bridge, Twilio,
# etc.) that you trust and have tested.
EVELYN_ALLOW_SEND=false

# Optional: a display name for the one contact you gave as an example
# ("text my wife"). Used only by the message tool's dry-run output.
EVELYN_DEFAULT_CONTACT_NAME=wife
